{
  "name": "wegstatus-polyline-selector",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "WME userscript that copies selected segments as a Wegstatus polyline.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
